DATABASE_URL="file:./dev.db"
PORT=5000
JWT_SECRET="skillbridge_super_secret_jwt_access_key_2026"
JWT_REFRESH_SECRET="skillbridge_super_secret_jwt_refresh_key_2026"
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"

# Real AI / LLM Providers (Bridge Bot, Resume Summary, Portfolio Copy)
# System automatically falls back to built-in offline intelligence when unset
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# OAuth 2.0 Credentials (Google, GitHub, Microsoft 365)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Email Notification Providers (Resend or SendGrid)
# System logs structured [WARN] telemetry with fallback to console when unset
RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_FROM="notifications@skillbridge.app"

# SMS Notification Providers (Twilio or MSG91)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
