# =============================================================================
# SkillBridge Environment Configuration
# =============================================================================

# Database Configuration (PostgreSQL managed instance, e.g., Render Managed PostgreSQL)
# When deploying to Render, set DATABASE_URL to your Render PostgreSQL connection string:
# postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillbridge?schema=public"

# Server Configuration
PORT=5000
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"

# Legacy JWT Authentication (Only used for test suites or when ALLOW_LEGACY_AUTH=true)
JWT_SECRET="skillbridge_super_secret_jwt_access_key_2026"
JWT_REFRESH_SECRET="skillbridge_super_secret_jwt_refresh_key_2026"
ALLOW_LEGACY_AUTH="false"

# Firebase Admin SDK (Server-side identity verification and token minting)
# Set FIREBASE_SERVICE_ACCOUNT_KEY to either:
# 1. Path to service account JSON (e.g. ./firebase-adminsdk.json)
# 2. Raw JSON stringified credentials (recommended for Render environment variables)
FIREBASE_SERVICE_ACCOUNT_KEY=""
FIREBASE_PROJECT_ID="sihi-5694c"

# Firebase Client SDK (Frontend authentication & session persistence)
# Public configuration for client browser authentication (safe for client bundles)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# AI / LLM Providers (Bridge Bot, Resume Analysis, Assessment Insights)
# System automatically falls back to built-in offline intelligence when unset
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# OAuth 2.0 Credentials (Google, GitHub, Microsoft 365)
# Google OAuth: Requires Web Application OAuth 2.0 Client ID from Google Cloud Console
# Authorized JS Origins: http://localhost:5173, https://your-production-domain.com
# Authorized Redirect URIs: http://localhost:5173/auth/callback, https://your-production-domain.com/auth/callback
VITE_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Email Notification Providers (Resend or SendGrid)
# System logs structured [WARN] telemetry with fallback to console when unset
RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_FROM="notifications@skillbridge.app"

# SMS Notification Providers (Twilio or MSG91)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
