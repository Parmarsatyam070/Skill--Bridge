datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  firebaseUid  String?   @unique
  email        String    @unique
  phone        String?   @unique
  phoneVerified Boolean  @default(false)
  passwordHash String?
  name         String
  role         String    // STUDENT | INDUSTRY | ACADEMICIAN | INSTITUTION_ADMIN
  avatarUrl    String?
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveDate String? // YYYY-MM-DD
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  studentProfile     StudentProfile?
  industryProfile    IndustryProfile?
  academicianProfile AcademicianProfile?
  institutionProfile InstitutionProfile?
  resetTokens        PasswordResetToken[]
  integrations       ExternalIntegration[]
  activityLogs       ActivityLog[]
  notifications      InAppNotification[]
  auditLogs          AuditLog[]
  collaborationMessages CollaborationMessage[]
}

model StudentProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution    String
  targetDomain   String
  cgpa           Float?
  bio            String?
  gradYear       Int?
  resumeUrl      String?
  githubUsername String?
  linkedinUrl    String?
  headline       String?
  location       String?
  resumeFileName String?
  experiencesJson String?      // JSON array of experiences
  educationsJson  String?      // JSON array of educations
  projectsJson    String?      // JSON array of projects
  certificatesJson String?    // JSON array of certificates
  responsibilitiesJson String? // JSON array of responsibilities
  achievementsJson String?     // JSON array of achievements
  socialsJson     String?      // JSON object of socials
  customSkillsJson String?     // JSON array of custom added skills

  skillScores    StudentSkillScore[]
  domains        StudentDomain[]
  applications   Application[]
  enrollments    Enrollment[]
  resumes        Resume[]
  portfolioWebsite PortfolioWebsite?
  assessmentAttempts AssessmentAttempt[]
  dsaAttempts    DSAAttempt[]
  dailyPractices DailyPractice[]
  targetInternshipId   String?
  targetInternship     Internship?          @relation("StudentTargetInternship", fields: [targetInternshipId], references: [id], onDelete: SetNull)
  mockInterviewSessions MockInterviewSession[]
  sashMemories         SashMemory[]
  candidateMatches     CandidateMatch[]
  savedOpportunities   SavedOpportunity[]
  assessmentSubmissions AssessmentSubmission[]
  interviewSessions    InterviewSession[]
  dailyTargets         DailyTarget[]
}

model Domain {
  id           String                   @id @default(uuid())
  name         String                   @unique // e.g. "Full-Stack Web", "AI/Data Science", "Cloud/DevOps", "UI/UX Product Design", "Embedded/IoT"
  slug         String                   @unique
  description  String
  avgSalaryINR Int                      // e.g. 1150000 (₹11.5 LPA)
  icon         String?                  // e.g. "Code", "Brain", "Cloud", "Palette", "Cpu"
  requirements DomainSkillRequirement[]
  students     StudentDomain[]
}

model DomainSkillRequirement {
  id             String @id @default(uuid())
  domainId       String
  domain         Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  skillId        String
  skill          Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  benchmarkScore Float  // 0 - 100 benchmark standard
  displayOrder   Int    @default(0)

  @@unique([domainId, skillId])
}

model StudentDomain {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  domainId    String
  domain      Domain         @relation(fields: [domainId], references: [id], onDelete: Cascade)
  isPrimary   Boolean        @default(false)
  addedAt     DateTime       @default(now())

  @@unique([studentId, domainId])
}

model IndustryProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  website        String?
  companySize    String?
  industrySector String
  verified       Boolean  @default(false)

  internships       Internship[]
  opportunities     Opportunity[]
  collaborations    Collaboration[]
  interviewSessions InterviewSession[]
  assessments       Assessment[]
}

model AcademicianProfile {
  id          String @id @default(uuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution String
  department  String
  designation String
}

model InstitutionProfile {
  id               String @id @default(uuid())
  userId           String @unique
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionName  String
  adminDesignation String

  collaborations   Collaboration[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  phone     String?
  otpCode   String?
  type      String    @default("EMAIL") // EMAIL | PHONE_OTP
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String   // Format: YYYY-MM-DD
  count      Int      @default(1)
  loggedInAt DateTime @default(now())

  @@unique([userId, date])
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String   // technical | soft | core
  description String?

  benchmarks              SkillBenchmark[]
  scores                  StudentSkillScore[]
  domainRequirements      DomainSkillRequirement[]
  aliases                 SkillAlias[]
  opportunityRequirements OpportunitySkill[]
}

model SkillBenchmark {
  id             String @id @default(uuid())
  domain         String
  skillId        String
  skill          Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  benchmarkScore Float  // 0 - 100 benchmark standard
  displayOrder   Int    @default(0)

  @@unique([domain, skillId])
}

model StudentSkillScore {
  id                 String         @id @default(uuid())
  studentId          String
  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId            String
  skill              Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  score              Float          // 0 - 100 current score
  lastAttemptDate    DateTime?      // Last attempt date evaluating this skill
  scoreHistoryJson   String?        // JSON array of [{ date, score, attemptId, delta }]
  inactivityDecayPct       Float          @default(0.0) // Mild decay percentage applied if inactive > 30 days
  decayDaysCount           Int            @default(0)   // Days since last attempt
  verificationLevel        String         @default("SELF-REPORTED") // SELF-REPORTED | COURSE-VERIFIED | ASSESSMENT-VERIFIED | PROJECT-VERIFIED | CERTIFICATION-VERIFIED
  verificationEvidenceJson String?        // JSON metadata of verification proof
  verifiedAt               DateTime?
  updatedAt                DateTime       @updatedAt

  @@unique([studentId, skillId])
}

model Question {
  id                  String            @id @default(uuid())
  domain              String
  skillId             String
  type                String            // technical | soft | aptitude
  questionType        String            @default("mcq") // mcq | written | coding
  prompt              String
  optionsJson         String            // JSON array of options [{id, text, isCorrect}]
  weight              Float             @default(1.0)
  practiceSetId       String?
  practiceSet         PracticeSet?      @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)
  listeningPassageId  String?
  listeningPassage    ListeningPassage? @relation(fields: [listeningPassageId], references: [id], onDelete: Cascade)
  passageText         String?           // For reading comprehension passages
  expectedAnswerRubric String?          // For AI rubric scoring of written answers
  explanation         String?           // Explanation shown after grading
  starterCode         String?           // Default code template for coding questions
  entryFunctionName   String?           // Explicit entry point function name to execute (e.g. solution, twoSum)
  testCasesJson       String?           // JSON array of [{ id, input, expectedOutput, isHidden, explanation }]
  constraints         String?           // Constraints text e.g. 1 <= n <= 10^5
  inputFormat         String?           // Description of input format
  outputFormat        String?           // Description of output format
  externalLinksJson   String?           // JSON array of outbound links [{ platform, topic, url }]
}

model CourseProvider {
  id         String   @id @default(uuid())
  name       String   @unique
  logoUrl    String?
  baseUrl    String
  isVerified Boolean  @default(true)

  courses    Course[]
}

model Course {
  id                String         @id @default(uuid())
  providerId        String
  provider          CourseProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title             String
  description       String
  skillsCoveredJson String         // JSON array of [{skillId, pointsGain}]
  externalUrl       String
  duration          String
  level             String         // Beginner | Intermediate | Advanced
  createdAt         DateTime       @default(now())

  enrollments       Enrollment[]
}

model Enrollment {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      String         // enrolled | completed
  enrolledAt  DateTime       @default(now())
  completedAt DateTime?

  @@unique([studentId, courseId])
}

model Internship {
  id                 String          @id @default(uuid())
  industryId         String
  industry           IndustryProfile @relation(fields: [industryId], references: [id], onDelete: Cascade)
  title              String
  description        String
  requiredSkillsJson String          // JSON array of [{skillId, weight, minScore}]
  stipend            String
  location           String
  workMode           String          // REMOTE | HYBRID | ON_SITE
  status             String          @default("OPEN") // OPEN | CLOSED | DRAFT
  postedAt           DateTime        @default(now())

  applications       Application[]
  targetStudents       StudentProfile[]     @relation("StudentTargetInternship")
  mockInterviewSessions MockInterviewSession[]
}

model Application {
  id                 String          @id @default(uuid())
  studentId          String
  student            StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internshipId         String?
  internship           Internship?     @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  opportunityId        String?
  opportunity          Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  resumeId             String?
  resume               Resume?         @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  status               String          @default("applied") // applied | under_review | shortlisted | assessment | interview | hired | rejected
  matchScoreAtApply    Float
  coverNote            String?
  interviewDetailsJson String?
  hiredDetailsJson      String?
  appliedAt            DateTime        @default(now())
  updatedAt            DateTime        @default(now()) @updatedAt

  @@index([studentId])
  @@index([internshipId])
  @@index([opportunityId])
  @@index([status])
}

model Resume {
  id           String         @id @default(uuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type         String         // AI_GENERATED | BUILT | UPLOADED
  title        String
  templateId   String?        // modern_clean | technical_ats | classic_academic | executive_pro | compact_engineer
  fileUrl      String?
  fileSize     String?
  isPrimary    Boolean        @default(false)
  contentJson  String?        // Structured resume data
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  applications Application[]
}

model AcademicOpportunity {
  id          String   @id @default(uuid())
  type        String   // fdp | research | industrial_training
  title       String
  description String
  postedBy    String
  deadline    String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
}

model ExternalIntegration {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform        String   // GITHUB | LINKEDIN
  profileDataJson String
  connectedAt     DateTime @default(now())

  @@unique([userId, platform])
}

model PortfolioWebsite {
  id                     String            @id @default(uuid())
  studentId              String            @unique
  student                StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slug                   String            @unique
  status                 String            @default("DRAFT") // DRAFT | PUBLISHED
  theme                  String            @default("teal_dark") // teal_dark | slate_clean | indigo_creative | cyber_amber
  enableBot              Boolean           @default(true)
  headline               String?
  subheadline            String?
  heroCtaText            String?           @default("View My Projects")
  heroCtaLink            String?           @default("#projects")
  heroImageUrl           String?
  servicesJson           String?           // JSON array of 3 cards: [{ icon, title, description }]
  projectsJson           String?           // JSON array of [{ id, title, description, tags: string[], thumbnail, githubUrl, demoUrl }]
  aboutBio               String?
  aboutImageUrl          String?
  skillsJson             String?           // JSON array of skill badge names/categories
  statsJson              String?           // JSON array of [{ label, value, subtext }]
  contactEmail           String?
  socialsJson            String?           // JSON object: { github, linkedin, twitter, website, email }
  sectionsOrderJson      String?           // JSON array: ['hero', 'services', 'projects', 'about', 'stats', 'contact', 'footer']
  sectionsVisibilityJson String?           // JSON object: { hero: true, services: true, projects: true, about: true, stats: true, contact: true, footer: true }
  aiWizardConfigJson     String?           // JSON wizard parameters used during generation
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  messages               PortfolioMessage[]
}

model PortfolioMessage {
  id          String           @id @default(uuid())
  portfolioId String
  portfolio   PortfolioWebsite @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  senderName  String
  senderEmail String
  message     String
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())
}

model PracticeSet {
  id               String              @id @default(uuid())
  domainId         String?
  domainName       String              // e.g. "Full-Stack Web", "AI/Data Science", "Aptitude - Quantitative", "Aptitude - English Reading", "Aptitude - English Listening"
  type             String              // domain | aptitude_quant | aptitude_english_reading | aptitude_english_listening
  title            String              // e.g. "Practice Set 1: Core Fundamentals"
  description      String
  timeLimitMinutes Int                 @default(25)
  passingScorePct  Float               @default(60.0)
  difficulty       String              @default("Intermediate") // Beginner | Intermediate | Advanced
  displayOrder     Int                 @default(1)
  createdAt        DateTime            @default(now())

  questions        Question[]
  attempts         AssessmentAttempt[]
}

model ListeningPassage {
  id              String     @id @default(uuid())
  title           String
  audioUrl        String?
  audioText       String     // Text read aloud via audio synthesis / Web Speech engine
  transcript      String     // Complete transcript for review
  durationSeconds Int        @default(60)

  questions       Question[]
}

model AssessmentAttempt {
  id                  String      @id @default(uuid())
  studentId           String
  student             StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  practiceSetId       String
  practiceSet         PracticeSet @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)
  startedAt           DateTime    @default(now())
  submittedAt         DateTime?
  timeSpentSeconds    Int         @default(0)
  score               Float       @default(0) // 0 - 100
  passed              Boolean     @default(false)
  answersJson         String      // Record<questionId, answerValue>
  aiGradingNotesJson  String?     // Detailed grading notes / feedback
  skillBreakdownJson  String?     // JSON of skill updates

  @@index([studentId, practiceSetId])
}

model InAppNotification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("DAILY_PRACTICE") // DAILY_PRACTICE | MATCH_ALERT | SKILL_UPDATE | SYSTEM
  link      String?  // Deep link URL e.g. /assessment?setId=...
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model LearningResource {
  id           String   @id @default(uuid())
  skillId      String?  // Associated Skill ID if specific e.g. skill-react
  topicTag     String   // Topic tag e.g. "DSA", "Dynamic Programming", "React", "TypeScript", "System Design"
  domain       String?  // Relevant domain e.g. "Full-Stack Web", "AI/Data Science", "Cloud/DevOps", "UI/UX Product Design"
  category     String   @default("recommended") // recommended | videos | courses | documentation | articles | practice | projects | books | interview_prep
  type         String   // website | app | youtube_channel | youtube_playlist | course | book | doc | github_repo
  title        String
  url          String
  provider     String   // e.g. "NeetCode", "freeCodeCamp", "takeUforward", "MDN Web Docs", "StatQuest", "TechWorld with Nana"
  description  String
  isFree       Boolean  @default(true)
  rating       Float?   @default(4.9)
  difficulty   String?  // Beginner | Intermediate | Advanced | All Levels
  authorityScore Float  @default(90.0) // 0 - 100 quality/authority ranking
  tagsJson     String?  // JSON array of subtopics / keywords
  thumbnailUrl String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([topicTag])
  @@index([category])
}

model DSAQuestion {
  id                String       @id @default(uuid())
  title             String
  slug              String       @unique
  platform          String       // LEETCODE | GEEKSFORGEEKS | CSES | CODEFORCES
  difficulty        String       // Easy | Medium | Hard
  topic             String       // e.g. "Arrays", "Dynamic Programming", "Graphs", etc.
  tagsJson          String       // JSON array of strings: ["two-pointers", "hash-table"]
  canonicalUrl      String       // Authentic URL
  estimatedMinutes  Int          @default(20)
  description       String?      // Problem summary / prompt
  starterCodeJson   String?      // JSON object or string with default templates per language
  testCasesJson     String?      // JSON array of [{ id, input, expectedOutput, isHidden }]
  entryFunctionName String?      // e.g. "twoSum", "maxSubArray"
  companyTagsJson   String?      // JSON array: ["Google", "Amazon", "Microsoft"]
  createdAt         DateTime     @default(now())

  attempts          DSAAttempt[]

  @@index([platform])
  @@index([difficulty])
  @@index([topic])
}

model DSAAttempt {
  id               String         @id @default(uuid())
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId       String
  question         DSAQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  status           String         @default("VIEWED") // VIEWED | ATTEMPTED | SOLVED | FAILED
  timeSpentSeconds Int            @default(0)
  codeSubmitted    String?
  language         String?        @default("javascript")
  attemptCount     Int            @default(1)
  isDailyPractice  Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([studentId, questionId])
  @@index([studentId, status])
  @@index([questionId])
}

model DailyPractice {
  id                       String         @id @default(uuid())
  studentId                String
  student                  StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date                     String         // Format: YYYY-MM-DD
  questionCount            Int            @default(15)
  questionIdsJson          String         // JSON array of DSAQuestion IDs in the daily set (15-30 items)
  completedQuestionIdsJson  String         @default("[]") // JSON array of solved/completed question IDs
  score                    Float          @default(0.0) // Completion score / points
  status                   String         @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  timeSpentSeconds         Int            @default(0)
  startedAt                DateTime?
  completedAt              DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@unique([studentId, date])
  @@index([studentId, date])
}

model Institution {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?
  state     String?
  type      String?
  createdAt DateTime @default(now())

  @@index([name])
}

model MockInterviewSession {
  id                 String         @id @default(uuid())
  studentId          String
  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internshipId       String?
  internship         Internship?    @relation(fields: [internshipId], references: [id], onDelete: SetNull)
  targetRole         String         // e.g. "Full-Stack Engineer Intern @ TechCorp"
  companyName        String?        // e.g. "TechCorp"
  date               String         // Format: YYYY-MM-DD
  status             String         @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | ABANDONED
  durationSeconds    Int            @default(0)
  overallScore       Float          @default(0.0) // 0 - 100
  communicationScore Float          @default(0.0) // 0 - 100
  technicalScore     Float          @default(0.0) // 0 - 100
  structureScore     Float          @default(0.0) // 0 - 100 (STAR method adherence)
  readinessTier      String         @default("Needs Work") // "High Readiness" | "Interview Ready" | "Developing" | "Needs Work"
  questionsJson      String         // JSON array of generated questions
  transcriptJson     String         // JSON array of student answers with timestamps and skipped status
  feedbackJson       String?        // JSON object of LLM evaluation, quoted feedback per question, strengths, weak areas
  identifiedGapsJson String?        // JSON array of identified weak topics e.g. ["State Management", "STAR Result quantification"]
  retakeNumber       Int            @default(1)
  isTimedOut         Boolean        @default(false)
  startedAt          DateTime       @default(now())
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([studentId, internshipId])
  @@index([studentId, date])
  @@index([studentId, status])
}

model SashMemory {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  category         String         // "goal" | "struggle" | "preference" | "fact" | "summary"
  key              String         // normalized identifier e.g. "target_company", "struggles_with_dp"
  value            String         // stored narrative fact or summary
  sourceMessage    String?        // prompt or exchange where fact was stated
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([studentProfileId, category, key])
  @@index([studentProfileId])
  @@index([studentProfileId, category])
}

// ========================================================
// TALENT PLATFORM CORE ADDITIVE MODELS
// ========================================================

model SkillAlias {
  id        String   @id @default(uuid())
  alias     String   @unique
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([alias])
}

model Opportunity {
  id                    String              @id @default(uuid())
  companyId             String
  company               IndustryProfile     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title                 String
  description           String
  type                  String              @default("JOB") // JOB | INTERNSHIP | APPRENTICESHIP | PROJECT | TRAINING | CERTIFICATION | WORKSHOP | HACKATHON | MENTORSHIP | GUEST_LECTURE | RESEARCH
  industry              String?
  location              String              @default("Remote")
  remote                Boolean             @default(true)
  workMode              String              @default("REMOTE") // REMOTE | HYBRID | ON_SITE
  experienceLevel       String              @default("ENTRY") // ENTRY | MID | SENIOR | LEAD
  educationRequirements String?
  stipend               String?
  duration              String?
  applicationDeadline   DateTime?
  status                String              @default("OPEN") // OPEN | PAUSED | CLOSED | DRAFT
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  skills                OpportunitySkill[]
  applications          Application[]
  matches               CandidateMatch[]
  assessments           Assessment[]
  savedByStudents       SavedOpportunity[]
  interviewSessions     InterviewSession[]

  @@index([companyId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model OpportunitySkill {
  id               String      @id @default(uuid())
  opportunityId    String
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skillId          String
  skill            Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillName        String?
  proficiencyLevel String      @default("INTERMEDIATE") // BEGINNER | INTERMEDIATE | ADVANCED | EXPERT
  weight           Int         @default(3) // 1 to 5
  minScore         Float       @default(70.0) // 0 to 100 benchmark
  isMandatory      Boolean     @default(true)

  @@unique([opportunityId, skillId])
  @@index([opportunityId])
  @@index([skillId])
}

model CandidateMatch {
  id                  String         @id @default(uuid())
  candidateId         String
  candidate           StudentProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  opportunityId       String
  opportunity         Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  score               Float          // 0 - 100 composite 7-factor score
  eligibility         Boolean        @default(true)
  ineligibilityReason String?
  algorithmVersion    String         @default("v2.0-7factor")
  calculatedAt        DateTime       @default(now())
  breakdownJson       String         // JSON: { technicalSkills, requiredSkills, projects, assessment, education, experience, certification }
  matchedSkillsJson   String
  missingSkillsJson   String
  strengthsJson       String
  weaknessesJson      String
  recommendationsJson String
  explanation         String?
  updatedAt           DateTime       @updatedAt

  @@unique([candidateId, opportunityId])
  @@index([opportunityId, score])
  @@index([candidateId])
}

model SavedOpportunity {
  id            String         @id @default(uuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  savedAt       DateTime       @default(now())

  @@unique([studentId, opportunityId])
  @@index([studentId])
}

model Assessment {
  id                 String                 @id @default(uuid())
  companyId          String?
  company            IndustryProfile?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityId      String?
  opportunity        Opportunity?           @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  title              String
  description        String
  durationMinutes    Int                    @default(45)
  passingScorePct    Float                  @default(70.0)
  requiredSkillsJson String?
  status             String                 @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  questions          AssessmentQuestion[]
  submissions        AssessmentSubmission[]

  @@index([companyId])
  @@index([opportunityId])
  @@index([status])
}

model AssessmentQuestion {
  id            String     @id @default(uuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  skillId       String?
  type          String     @default("MCQ") // MCQ | TECHNICAL | SCENARIO | BEHAVIORAL | SHORT_ANSWER
  prompt        String
  optionsJson   String?
  rubric        String?
  starterCode   String?
  testCasesJson String?
  points        Float      @default(10.0)
  displayOrder  Int        @default(1)

  @@index([assessmentId])
}

model AssessmentSubmission {
  id                      String         @id @default(uuid())
  assessmentId            String
  assessment              Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId               String
  student                 StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt               DateTime       @default(now())
  submittedAt             DateTime?
  timeSpentSeconds        Int            @default(0)
  score                   Float          @default(0.0)
  passed                  Boolean        @default(false)
  technicalScore          Float          @default(0.0)
  skillScoreBreakdownJson String?
  answersJson             String
  feedbackJson            String?
  createdAt               DateTime       @default(now())

  @@index([assessmentId, studentId])
  @@index([studentId])
}

model InterviewSession {
  id             String          @id @default(uuid())
  opportunityId  String?
  opportunity    Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  candidateId    String
  candidate      StudentProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  recruiterId    String?
  recruiter      IndustryProfile? @relation(fields: [recruiterId], references: [id], onDelete: SetNull)
  type           String          @default("TECHNICAL") // TECHNICAL | BEHAVIORAL | HR | MIXED
  status         String          @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  scheduledAt    DateTime?
  completedAt    DateTime?
  questionsJson  String?
  transcriptJson String?
  evaluationJson String?
  overallScore   Float?
  recommendation String?         // STRONGLY_RECOMMEND | RECOMMEND | MAYBE | DO_NOT_RECOMMEND (Advisory)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([opportunityId])
  @@index([candidateId])
  @@index([recruiterId])
  @@index([status])
}

model Collaboration {
  id               String               @id @default(uuid())
  institutionId    String
  institution      InstitutionProfile   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  companyId        String
  company          IndustryProfile      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type             String               @default("WORKSHOP") // MENTORSHIP | GUEST_LECTURE | WORKSHOP | HACKATHON | LIVE_PROJECT | RESEARCH | APPRENTICESHIP | TRAINING | CURRICULUM_FEEDBACK | FACULTY_DEV | PLACEMENT_DRIVE
  title            String
  description      String
  skillsJson       String?
  targetDepartment String?
  proposedDate     String?
  startDate        DateTime?
  endDate          DateTime?
  status           String               @default("REQUESTED") // REQUESTED | DISCUSSION | APPROVED | ACTIVE | COMPLETED | REJECTED | CANCELLED
  initiatedByRole  String               @default("INDUSTRY")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  messages         CollaborationMessage[]

  @@index([institutionId])
  @@index([companyId])
  @@index([status])
}

model CollaborationMessage {
  id              String        @id @default(uuid())
  collaborationId String
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  senderUserId    String
  senderUser      User          @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  message         String
  createdAt       DateTime      @default(now())

  @@index([collaborationId])
}

model SkillDemandSnapshot {
  id               String   @id @default(uuid())
  skillName        String
  category         String   @default("technical")
  demandCount      Int      @default(0)
  demandPct        Float    @default(0.0)
  trendDirection   String   @default("STABLE") // GROWING | STABLE | DECLINING | EMERGING
  difficultyRating Float    @default(50.0)
  source           String   @default("SkillBridge Internal Demand")
  snapshotDate     String   // YYYY-MM
  createdAt        DateTime @default(now())

  @@unique([skillName, snapshotDate])
  @@index([demandCount])
  @@index([snapshotDate])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String   // e.g. OPPORTUNITY_CREATED, CANDIDATE_SHORTLISTED, INTERVIEW_EVALUATED
  entity       String   // Opportunity, Application, Collaboration, etc.
  entityId     String?
  metadataJson String?
  timestamp    DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([timestamp])
}

model DailyTarget {
  id             String         @id
  studentId      String
  date           String
  title          String
  targetGoal     String
  actionLabel    String
  targetType     String
  targetUrl      String
  targetRefId    String?
  roadmapPhase   String
  focusTopic     String
  rationale      String
  completed      Boolean        @default(false)
  completedAt    DateTime?
  metadataJson   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now())
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId, date])
}
